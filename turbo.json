{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["DATABASE_URL", "REDIS_URL", "SPIRE_EAGER_MAX_BYTES", "SPIRE_EAGER_MAX_FILES", "SPIRE_SESSION_STALE_MS"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "@spire/types#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@spire/stores#build": {
      "dependsOn": ["@spire/types#build"],
      "outputs": ["dist/**"]
    },
    "@spire/db#build": {
      "dependsOn": ["@spire/types#build"],
      "outputs": ["dist/**"]
    },
    "@zenshilabs/spire#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["API_BASE_URL", "SPIRE_API_URL"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "web#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "@spire/types#build",
        "@spire/stores#build",
        "@spire/db#build"
      ]
    }
  }
}
