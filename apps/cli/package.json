{
  "name": "@spire/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "spire": "./dist/index.mjs"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsdown src/index.ts --format esm --platform node --target node22 --no-dts",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@spire/types": "workspace:*",
    "@clack/prompts": "^1.6.0",
    "chokidar": "^5.0.0",
    "ignore": "^7.0.5"
  },
  "devDependencies": {
    "@spire/eslint-config": "workspace:*",
    "@spire/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "tsdown": "^0.22.3",
    "tsx": "^4.22.4",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
