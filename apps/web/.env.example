# Postgres connection string (Neon). Used by the web app at runtime and by
# drizzle-kit for migrations (see packages/db/drizzle.config.ts).
# Copy this file to .env.local and paste your Neon connection string.
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# Optional. Enables cross-instance live events plus a shared session/blob cache.
# Leave unset to run single-instance with in-process pub/sub (zero config).
# Must be a TCP rediss:// URL (e.g. Upstash) — the HTTP REST API cannot hold the
# long-lived SUBSCRIBE the SSE fan-out needs.
# REDIS_URL="rediss://default:password@xxxx.upstash.io:6379"

# Public site origin, used for absolute metadata URLs (Open Graph, sitemap,
# robots, JSON-LD). Defaults to http://localhost:3000 in dev.
# NEXT_PUBLIC_SITE_URL="https://your-instance.example.com"

# Bearer token protecting the retention cleanup cron at /api/cron/cleanup.
# CRON_SECRET="a-long-random-secret"

# Optional. Days an ended session is kept before the cleanup cron deletes it.
# Defaults to 30.
# SPIRE_RETENTION_DAYS="30"
